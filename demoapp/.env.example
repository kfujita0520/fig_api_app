# Figment API key (required for stake / rewards / activity API calls).
VITE_FIGMENT_API_KEY=your-figment-api-key

# Solana cluster: devnet, mainnet-beta, or testnet
VITE_SOLANA_CLUSTER=devnet

# Optional RPC with full history for Activity
# VITE_SOLANA_RPC_URL=https://your-solana-rpc.example

# Optional validator vote account
# VITE_FIGMENT_VOTE_ACCOUNT=your-vote-account-pubkey

# Optional Figment API base (default: /figment-api same-origin proxy)
# VITE_FIGMENT_API_BASE=/figment-api
