# Server-only Figment API key. Never use VITE_ prefix.
FIGMENT_API_KEY=your-figment-api-key

# Optional CORS allowlist (same-origin deploy usually does not need this).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local API port (default 3001 so it does not clash with widgetDemo on 3000)
PORT=3001

# Frontend (Vite) — same-origin BFF by default
# VITE_FIGMENT_API_BASE=/api/figment
VITE_SOLANA_CLUSTER=devnet

# Optional server-only RPC for Activity gap-fill (do not use VITE_ prefix).
# Used only when Figment GET /solana/activities has no rows for the wallet.
# SOLANA_RPC_URL=https://your-solana-rpc.example

# Optional validator vote account
# VITE_FIGMENT_VOTE_ACCOUNT=your-vote-account-pubkey
