# Server-only Figment API key (Vercel: Secret visibility). Never use VITE_ prefix.
FIGMENT_API_KEY=your-figment-api-key

# Optional: comma-separated browser origins allowed to call this BFF (CORS).
# Include demoapp2 local origin (and production host when deployed).
ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Optional local port (default 3000)
# PORT=3000
