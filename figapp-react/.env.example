# Figment API key (required for Stake and Broadcast).
# Get your key from https://figment.io
VITE_FIGMENT_API_KEY=your-figment-api-key

# Solana cluster: devnet, mainnet-beta, or testnet
VITE_SOLANA_CLUSTER=devnet

# Optional: validator vote account. If unset, devnet uses Figment default.
# Devnet default: 21Jxcw74j5SvajRKE3PvNifu26CVorF7DF8HyanKNzZ3
# VITE_FIGMENT_VOTE_ACCOUNT=your-vote-account-pubkey
